{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/src",
  "projectType": "library",
  "tags": ["type:ui"],
  "targets": {
    "storybook": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "storybook dev -p 6006 -c libs/ui/.storybook --no-open --disable-telemetry"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/storybook/ui"],
      "options": {
        "command": "storybook build -c libs/ui/.storybook -o dist/storybook/ui --disable-telemetry"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/ui/tsconfig.json" }
    }
  }
}
